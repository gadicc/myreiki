# Next loads .env.local. Standalone commands use `bun run loom env -- ...`.
# The local app runs on port 3006. Never commit real credentials.
DEV_PORT=3006
BETTER_AUTH_DEV_URL=http://localhost:3006
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use the independent synthetic development root, never the private rehearsal
# or Production branch. These are populated by the approved Loom/Neon setup.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional fixed synthetic UI fixtures: development + loopback only.
# Leave disabled on shared machines. This is forbidden in deployment settings.
LOOM_LOCAL_TEST_LOGIN=0

# Production only: public origin and reviewed completed-bootstrap fingerprint.
# Without a matching completed import, Production auth/data routes return 503.
# BETTER_AUTH_URL=https://www.myreiki.app
# MYREIKI_IMPORT_PLAN_SHA256=

# Separately governed direct migration credential, never shipped to the browser.
# MIGRATION_DATABASE_URL_UNPOOLED=
# LOOM_MIGRATION_DATABASE_ROLE=
