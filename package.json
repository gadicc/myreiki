{
  "name": "myreiki",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3006",
    "build": "next build && bun run pwa:build",
    "start": "next start",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "loom": "loom",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run loom:check",
    "loom:check": "loom check",
    "pwa:build": "NO_UPDATE_NOTIFIER=1 node node_modules/@serwist/cli/dist/bin.mjs build serwist.config.mjs",
    "db:fixtures": "loom db fixtures",
    "db:generate": "bun run drizzle-kit generate",
    "db:migrate": "loom env -- node --import tsx scripts/migrate.ts",
    "db:push": "bun run drizzle-kit push",
    "drizzle-kit": "NODE_OPTIONS='--import tsx' loom env -- drizzle-kit --config=./drizzle.config.ts",
    "schema:gen": "loom db schema-gen",
    "check:production": "bun run check && loom check --production",
    "test:browser": "loom env -- playwright test"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@gadicc/loom": "2.0.4",
    "@hookform/resolvers": "6.0.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@mui/system": "9.5.0",
    "@mui/x-date-pickers": "9.16.0",
    "@neondatabase/serverless": "^1.1.0",
    "@serwist/next": "9.5.13",
    "better-auth": "1.7.12",
    "dayjs": "^1.11.10",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.2",
    "pg": "8.23.1",
    "postgres": "^3.4.9",
    "radash": "^12.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-highlight-words": "^0.20.0",
    "react-hook-form": "7.90.0",
    "react-virtuoso": "^4.7.9",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "superjson": "^2.2.6",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.64.1",
    "@serwist/cli": "9.5.13",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-highlight-words": "^0.16.7",
    "drizzle-kit": "^0.31.10",
    "drizzle-valibot": "^0.4.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.2",
    "mongodb": "6.5.0",
    "serwist": "9.5.13",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vercel": "60.0.1",
    "vitest": "5.0.5"
  },
  "browser": {
    "crypto": false
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
